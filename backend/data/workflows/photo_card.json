{
  "_description": "剧照卡片模板 - 电影海报+毛玻璃背景+大字标题",
  "_output_node_id": 9,
  "_checkpoint_hint": "sd_xl_base_1.0.safetensors 或 flux1-dev.safetensors",
  "1": {
    "_meta": {"title": "Checkpoint Loader"},
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
  },
  "2": {
    "_meta": {"title": "CLIP Text Encode (Positive)", "role": "positive"},
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "cinematic movie poster, dramatic lighting, film grain, 4K quality, professional cinematography", "clip": ["1", 1]}
  },
  "3": {
    "_meta": {"title": "CLIP Text Encode (Negative)", "role": "negative"},
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "text, watermark, signature, low quality, blurry, distorted, ugly, bad composition", "clip": ["1", 1]}
  },
  "4": {
    "_meta": {"title": "Empty Latent Image"},
    "class_type": "EmptyLatentImage",
    "inputs": {"width": 1080, "height": 1920, "batch_size": 1}
  },
  "5": {
    "_meta": {"title": "KSampler"},
    "class_type": "KSampler",
    "inputs": {
      "seed": 42, "steps": 25, "cfg": 7.5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "_meta": {"title": "VAE Decode"},
    "class_type": "VAEDecode",
    "inputs": {"samples": ["5", 0], "vae": ["1", 2]}
  },
  "7": {
    "_meta": {"title": "Save Image (Preview)"},
    "class_type": "PreviewImage",
    "inputs": {"images": ["6", 0]}
  },
  "8": {
    "_meta": {"title": "Save Image (Output)"},
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "photo_card", "images": ["6", 0]}
  }
}
