{
  "_description": "分屏对比模板 - 两个角色/场景左右对比",
  "_output_node_id": 8,
  "_checkpoint_hint": "sd_xl_base_1.0.safetensors 或 flux1-dev.safetensors",
  "1": {
    "_meta": {"title": "Checkpoint Loader"},
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
  },
  "2": {
    "_meta": {"title": "CLIP Text Encode (Positive)", "role": "positive"},
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "split screen composition, two contrasting scenes side by side, cinematic lighting, dramatic contrast, professional movie poster", "clip": ["1", 1]}
  },
  "3": {
    "_meta": {"title": "CLIP Text Encode (Negative)", "role": "negative"},
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "text, watermark, low quality, blurry, asymmetrical, chaotic", "clip": ["1", 1]}
  },
  "4": {
    "_meta": {"title": "Empty Latent Image"},
    "class_type": "EmptyLatentImage",
    "inputs": {"width": 1920, "height": 1080, "batch_size": 1}
  },
  "5": {
    "_meta": {"title": "KSampler"},
    "class_type": "KSampler",
    "inputs": {
      "seed": 42, "steps": 25, "cfg": 7.5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "_meta": {"title": "VAE Decode"},
    "class_type": "VAEDecode",
    "inputs": {"samples": ["5", 0], "vae": ["1", 2]}
  },
  "7": {
    "_meta": {"title": "Preview Image"},
    "class_type": "PreviewImage",
    "inputs": {"images": ["6", 0]}
  },
  "8": {
    "_meta": {"title": "Save Image"},
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "split_comparison", "images": ["6", 0]}
  }
}
